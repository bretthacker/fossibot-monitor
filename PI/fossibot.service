# /etc/systemd/system/fossibot.service
# Install:
#   sudo cp fossibot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable fossibot
#   sudo systemctl start fossibot
#   sudo journalctl -u fossibot -f

[Unit]
Description=Fossibot Telemetry Bridge
After=network.target
# Ensure WiFi is up before starting
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=brett
WorkingDirectory=/opt/fossibot
ExecStart=/usr/bin/python3 /opt/fossibot/main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
