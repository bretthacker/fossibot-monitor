# /etc/systemd/system/fossibot.service
# Install:
#   sudo cp fossibot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable fossibot
#   sudo systemctl start fossibot
#   sudo journalctl -u fossibot -f

[Unit]
Description=Fossibot Telemetry Bridge
After=network.target
# Ensure WiFi is up before starting
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Dedicated unprivileged account: sudo useradd --system --no-create-home --shell /usr/sbin/nologin fossibot
User=fossibot
Group=fossibot
WorkingDirectory=/opt/fossibot
# /run/fossibot (tmpfs) for optional raw capture — keeps writes off the SD card
RuntimeDirectory=fossibot
# Don't write .pyc files next to the code
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/fossibot/main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
